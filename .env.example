# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/bookroom

# NextAuth (Auth.js v5)
NEXTAUTH_SECRET=generate_a_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (соцмережа для входу — опційно)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (завантаження обкладинок книг і аватарів)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Нова Пошта API (вибір міста й відділення при оформленні замовлення)
NOVA_POSHTA_API_KEY=
